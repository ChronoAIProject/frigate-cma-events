# Copy outside this checkout, then replace the example values. No secrets here.
APP_ORIGIN=https://dining.example.com
APP_SERVICE=dining-api
CAMERA=example_dining
SEATS_ZONE=example_seats
TABLE_ZONE=example_table
EVENT_SOURCE=urn:frigate:example
TIMEZONE=UTC
WORKER_NAME=DiningAnalysisWorker
MODEL_SERVICE=chrono-llm-public
MODEL_NAME=gpt-6.1-sol
MODEL_THINKING_EFFORT=medium
EVIDENCE_SERVICE=example-dining-evidence
EVIDENCE_CROP_PADDING=0.04
EVIDENCE_MAX_WIDTH=1280
EVIDENCE_MAX_HEIGHT=720
EVIDENCE_JPEG_QUALITY=92
FRIGATE_PROXY_URL=https://nyxid.example.com/api/v1/proxy/s/example-frigate
SHEETS_SERVICE=api-google-workspace
SHEET_CONNECTION=REPLACE_WITH_GOOGLE_CONNECTION_UUID
SHEET_ID=REPLACE_WITH_SPREADSHEET_ID
SHEET_TAB='Dining records'
CMA_OWNER_ID=REPLACE_WITH_NYXID_USER_UUID
CMA_HMAC_KEY_ID=dining-v1
CMA_API_BASE=https://cma-api.example.com/api/v1
CMA_GATEWAY_BASE=https://cma.example.com/event-gateway/v1
MQTT_HOST=core-mosquitto
MQTT_PORT=1883
MQTT_USERNAME=example-relay
MQTT_TLS=false
MINIMUM_SECONDS=480
MAXIMUM_SECONDS=14400
MERGE_SECONDS=300
DELIVERY_GRACE_SECONDS=60
COOLDOWN_SECONDS=3600
MAX_PER_DAY=3
HEARTBEAT_SECONDS=90
TICK_SECONDS=5
PERSISTENCE_BACKEND=mongodb
# Optional: TARGET_ORG_ID, CMA_EVENT_URL (after channel creation).
